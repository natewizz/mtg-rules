{
  "name": "mtg-rules",
  "version": "0.2.0",
  "description": "Parse the official Magic: The Gathering Comprehensive Rules into validated, deterministic data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natewizz/mtg-rules.git"
  },
  "homepage": "https://github.com/natewizz/mtg-rules#readme",
  "bugs": {
    "url": "https://github.com/natewizz/mtg-rules/issues"
  },
  "keywords": [
    "magic",
    "magic-the-gathering",
    "mtg",
    "comprehensive-rules",
    "rules",
    "parser"
  ],
  "type": "module",
  "bin": {
    "mtg-rules": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "schema",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check .",
    "fetch": "tsx src/cli.ts fetch",
    "parse": "tsx src/cli.ts parse",
    "validate": "tsx src/cli.ts validate",
    "rule": "tsx src/cli.ts rule",
    "package-data": "tsx src/cli.ts package-data",
    "example:parse": "tsx examples/parse.ts",
    "example:lookup": "tsx examples/lookup.ts",
    "example:validate": "tsx examples/validate.ts",
    "example:diff": "tsx examples/diff.ts",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
