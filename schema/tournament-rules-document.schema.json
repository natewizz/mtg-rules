{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtg-rules/mtg-rules/schema/tournament-rules-document.schema.json",
  "title": "MTG Tournament Rules Document v0.1",
  "type": "object",
  "required": [
    "version",
    "metadata",
    "introduction",
    "sections",
    "rules",
    "credits",
    "classification"
  ],
  "properties": {
    "version": { "const": "0.1.0" },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "effectiveDate",
        "sourceUrl",
        "sourceSha256",
        "dataProfile",
        "externalLinks",
        "provenance",
        "notices"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "effectiveDate": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dataProfile": { "const": "complete-generated-tournament-rules" },
        "externalLinks": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "provenance": {
          "type": "object",
          "required": ["provider", "document", "effectiveDate", "sourceUrl", "sha256"],
          "properties": {
            "provider": { "const": "wizards-of-the-coast" },
            "document": { "const": "magic-tournament-rules" },
            "effectiveDate": { "type": "string", "minLength": 1 },
            "sourceUrl": { "type": "string", "format": "uri" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "notices": {
          "type": "object",
          "required": [
            "unofficial",
            "freeUseOnly",
            "commercialUsePermitted",
            "statements",
            "officialSourcePage"
          ],
          "properties": {
            "unofficial": { "const": true },
            "freeUseOnly": { "const": true },
            "commercialUsePermitted": { "const": false },
            "statements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "officialSourcePage": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "introduction": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "title", "section", "text", "examples", "hash"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "section": { "type": "string" },
          "text": { "type": "string" },
          "examples": { "type": "array", "items": { "type": "string" } },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "links": { "type": "array", "items": { "type": "string", "format": "uri" } }
        },
        "additionalProperties": false
      }
    },
    "credits": { "type": "array", "items": { "type": "string" } },
    "classification": {
      "type": "object",
      "required": ["unclassified"],
      "properties": {
        "unclassified": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
